# =============================================================
# idobata-ai 環境変数設定サンプル
# このファイルをコピーして .env を作成し、各値を設定してください。
# cp .env.example .env
# =============================================================

# Anthropic APIキー（必須）
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLiteデータベースファイルパス（任意、デフォルト: ./data/idobata.db）
DATABASE_PATH=./data/idobata.db

# 井戸端会議の最小参加者数（任意、デフォルト: 2）
MIN_PARTICIPANTS=2

# 井戸端会議の最大参加者数（任意、デフォルト: 3）
MAX_PARTICIPANTS=3

# サーバーのリスニングポート（任意、デフォルト: 8000）
PORT=8000

# 会話生成に使用するAnthropicモデル（任意、デフォルト: claude-sonnet-4-6）
CONVERSATION_MODEL=claude-sonnet-4-6

# 参加者スコアリングに使用するAnthropicモデル（任意、デフォルト: claude-haiku-4-5-20251001）
SCORING_MODEL=claude-haiku-4-5-20251001
